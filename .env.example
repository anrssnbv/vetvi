# Скопируйте в .env. Задайте собственный случайный пароль (не менее 12 символов).
OWNER_LOGIN=admin
OWNER_SUBJECT=owner
HOST=127.0.0.1
PORT=3001
PUBLIC_BASE_URL=http://127.0.0.1:3001
UI_ORIGIN=http://127.0.0.1:5173
# Только для явно выбранного HTTP-доступа без TLS; пароль и cookie не шифруются.
ALLOW_INSECURE_HTTP=false
DATABASE_PATH=./data/tasks.sqlite
SEED_DEMO=true
# Для удалённого MCP: HTTPS, внешний OAuth 2.1 сервер и subject владельца.
# OAUTH_AUDIENCE должен совпадать с PUBLIC_BASE_URL без завершающего / + /mcp.
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URL=

# Optional individual SK AI identity and agents; both files supplied by the operator.
# Leave both empty to retain isolated legacy access. Never enable legacy login over mapped data.
SK_AI_SOCKET_PATH=
SK_AI_CLIENT_KEY_FILE=

OWNER_PASSWORD=
