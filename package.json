{
  "name": "vetvi-task-graph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test server/*.test.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "mcp:local": "node --import tsx server/stdio.ts",
    "tunnel:start": "node scripts/tunnel.mjs start",
    "tunnel:status": "node scripts/tunnel.mjs status",
    "tunnel:stop": "node scripts/tunnel.mjs stop",
    "tunnel:doctor": "node scripts/tunnel.mjs doctor",
    "backup": "tsx --env-file-if-exists=.env server/backup.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@xyflow/react": "^12.10.0",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0"
  }
}
